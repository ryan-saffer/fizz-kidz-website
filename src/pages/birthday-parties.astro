---
// import "@/styles/globals.css";
import Layout from "@/layout/Layout.astro";
import PageIntro from "@/components/page-intro.astro";
import { Image } from "astro:assets";
import partyHero from "@/assets/images/pages/parties/party-hero.jpg";
import { BreadcrumbWrapper } from "@/react-components/breadcrumb-wrapper";
import StarBulletPoints from "@/components/star-bullet-points.astro";

import forwardArrow from "@/assets/images/pages/parties/forward-arrow.png";
import Step from "@/components/step.astro";
import PrimaryButton from "@/components/primary-button.astro";

import essendonStudio from "@/assets/images/pages/parties/essendon-studio.jpg";
import atHomeParties from "@/assets/images/pages/parties/at-home-parties.png";
import Pricing from "@/components/pricing.astro";
import PartyInformation from "@/components/party-information.astro";
import MixAndMatchParties from "@/components/mix-and-match-parties.astro";
// import PartyPacks from "@/components/party-packs.astro";
import PartyThemes from "@/components/party-themes.astro";
import PartyFaq from "@/components/party-faq.astro";
import Values from "@/components/values.astro";
import PartyPerks from "@/components/party-perks.astro";
import {
  createBreadcrumbSchema,
  createFaqSchema,
  createServiceSchema,
} from "@/utils/seo";

const { default: greenClock } = await import(
  `@/assets/images/pages/parties/green-clock.svg?raw`
);
const { default: blueCalendar } = await import(
  `@/assets/images/pages/parties/blue-calendar.svg?raw`
);
const { default: purpleHat } = await import(
  `@/assets/images/pages/parties/purple-hat.svg?raw`
);

const { default: greenDrop } = await import(
  `@/assets/images/pages/parties/drop-green.svg?raw`
);
const { default: blueDrop } = await import(
  `@/assets/images/pages/parties/drop-blue.svg?raw`
);
const { default: purpleDrop } = await import(
  `@/assets/images/pages/parties/drop-purple.svg?raw`
);

const birthdayFaqItems = [
  {
    question: "Where are Fizz Kidz birthday party venues located?",
    answer:
      "Fizz Kidz hosts kids birthday parties at our Balwyn, Cheltenham, Essendon, Kingsville and Malvern studios across Melbourne.",
  },
  {
    question: "What age group are Fizz Kidz birthday parties for?",
    answer:
      "Fizz Kidz birthday parties are designed for children aged 4 to 12 years, with creative hands-on activities, games and take-home creations.",
  },
  {
    question: "How long does a Fizz Kidz birthday party run for?",
    answer:
      "Families can choose a 1.5 hour party where children make two creations, or a 2 hour party where children make three creations.",
  },
  {
    question: "When do I choose my creations?",
    answer: "You choose your creations 10 days before your child's party.",
  },
  {
    question: "When do I let you know numbers?",
    answer:
      "You confirm numbers 10 days before your child's party. We only charge for the number of children who attend.",
  },
  {
    question: "Can parents stay during the party?",
    answer:
      "Yes. Parents can stay during the party or use it as a drop-off party.",
  },
];
---

<Layout
  title="Kids Birthday Party Venues Melbourne | Fizz Kidz"
  description="Book creative kids birthday party venues in Melbourne for ages 4-12 at Fizz Kidz studios in Balwyn, Cheltenham, Essendon, Kingsville and Malvern."
  schema={[
    createServiceSchema({
      name: "Kids Birthday Party Venues Melbourne",
      description:
        "Creative, hands-on kids birthday parties for children aged 4 to 12 at Fizz Kidz studios across Melbourne.",
      url: "/birthday-parties/",
      serviceType: "Kids birthday party venue",
      areaServed: [
        "Melbourne",
        "Balwyn",
        "Cheltenham",
        "Essendon",
        "Kingsville",
        "Malvern",
      ],
    }),
    createFaqSchema("/birthday-parties/", birthdayFaqItems),
    createBreadcrumbSchema([
      { name: "Home", url: "/" },
      { name: "Birthday Parties", url: "/birthday-parties/" },
    ]),
  ]}
>
  <main>
    <div class="m-auto block max-w-[1380px] px-5 pt-4">
      <BreadcrumbWrapper
        client:idle
        items={[
          {
            type: "dropdown",
            title: "Birthday Parties",
            items: [
              {
                type: "link",
                title: "Birthday Parties",
                path: "/birthday-parties/",
                isNew: false,
              },
              {
                type: "link",
                title: "Holiday Programs",
                path: "/holiday-programs/",
                isNew: false,
              },
              {
                type: "link",
                title: "Preschool Program",
                path: "/preschool-program/",
                isNew: false,
              },
            ],
          },
        ]}
      />
      <section class="mb-12 md:mb-40">
        <PageIntro
          subtitle="The magic of glitter, colour and exploding fun!"
          type="image"
          image={partyHero}
          imageAlt="Party Hero"
          actionButtonPath="/birthday-parties/book-a-party/#book"
          actionButtonText="Book a Party"
          color="purple"
        >
          <span slot="title">Fizz Kidz Birthday Parties</span>
          <span slot="content"
            >Fizz Kidz kids birthday parties are stress-free, high-energy and
            hands-on, with creative party venues across Melbourne for children
            aged 4 to 12.
          </span>
        </PageIntro>
      </section>
      <section class="mb-16 rounded-3xl bg-[#FFF5FB] p-6 md:mb-24 md:p-10">
        <h2 class="font-lilita text-4xl text-[#F24DA1] md:text-5xl">
          Kids birthday party venues in Melbourne
        </h2>
        <p class="mt-4 max-w-5xl font-gotham text-lg font-medium leading-8">
          Looking for a kids birthday party venue in Melbourne that keeps the
          children entertained and gives parents a stress-free experience? Fizz
          Kidz parties include exclusive studio hire, two enthusiastic party
          hosts, creative take-home activities, dancing games, invitations and
          optional party food.
        </p>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          <div class="rounded-2xl bg-white p-5 shadow-around">
            <p class="font-lilita text-2xl text-[#F24DA1]">Party themes</p>
            <p class="mt-2 font-gotham font-medium">
              Slime, science, glam, fairy, safari, unicorn, tie dye, Swiftie and
              more.
            </p>
          </div>
          <div class="rounded-2xl bg-white p-5 shadow-around">
            <p class="font-lilita text-2xl text-[#F24DA1]">Locations</p>
            <p class="mt-2 font-gotham font-medium">
              Balwyn, Cheltenham, Essendon, Kingsville and Malvern studios.
            </p>
          </div>
          <div class="rounded-2xl bg-white p-5 shadow-around">
            <p class="font-lilita text-2xl text-[#F24DA1]">Best for</p>
            <p class="mt-2 font-gotham font-medium">
              Creative birthday parties for children aged 4 to 12.
            </p>
          </div>
        </div>
      </section>
      <PartyThemes />
      <section class="mt-16 md:mt-40">
        <h2 class="mb-12 text-center font-lilita text-4xl md:mb-28 md:text-6xl">
          How it works
        </h2>
        <div
          class="flex flex-col items-center justify-center gap-4 min-[1200px]:flex-row min-[1200px]:items-stretch"
        >
          <Step
            title="Choose a party length"
            color="#4FE16D"
            number="1"
            icon={greenClock}
            iconAlt="green clock"
            background={greenDrop}
            backgroundPosition="-bottom-24 -left-12"
            iconClass="min-h-[400px]"
          >
            <div slot="content">
              <h3 class="mb-2 font-lilita text-2xl">1.5 Hour Party</h3>
              <StarBulletPoints
                content={[
                  "Two Creations Per Child",
                  "Two Fantastic Party Hosts",
                  "Exclusive Party Venue",
                ]}
                className="pl-4"
              />
              <h3 class="mb-2 mt-4 font-lilita text-2xl">2 Hour Party</h3>
              <StarBulletPoints
                content={[
                  "Three Creations Per Child",
                  "Two Fantastic Party Hosts",
                  "Exclusive Party Venue",
                ]}
                className="pl-4"
              />
            </div>
          </Step>
          <Image
            src={forwardArrow}
            alt="forward arrow"
            class="h-16 w-fit self-center"
          />
          <Step
            title="Choose your day, time & venue"
            color="#42D4F3"
            number="2"
            icon={blueCalendar}
            iconAlt="blue calendar"
            background={blueDrop}
            backgroundPosition="-bottom-24 -left-8"
            iconClass="min-h-[400px]"
          >
            <div slot="content">
              <h3 class="mb-2 font-lilita text-2xl">Friday</h3>
              <StarBulletPoints
                content={["4:30pm or 6:30pm"]}
                className="pl-4"
              />
              <h3 class="mb-2 mt-4 font-lilita text-2xl">
                Saturdays and Sundays
              </h3>
              <StarBulletPoints
                content={["10am, 12pm, 2:30pm and 4:30pm"]}
                className="pl-4"
              />
              <h3 class="mb-2 mt-4 font-lilita text-2xl">Venue</h3>
              <StarBulletPoints
                content={[
                  "Balwyn, Cheltenham, Essendon, Kingsville and Malvern venues",
                ]}
                className="pl-4"
              />
            </div>
          </Step>
          <Image
            src={forwardArrow}
            alt="forward arrow"
            class="h-16 w-fit self-center"
          />
          <Step
            title="Personalise"
            color="#9044E2"
            number="3"
            icon={purpleHat}
            iconAlt="purple hat"
            background={purpleDrop}
            backgroundPosition="right-0 -bottom-24"
            iconClass="min-[415px]:min-h-[400px] min-h-[500px]"
          >
            <div slot="content">
              <StarBulletPoints
                content={[
                  "Choose your favourite creations to make",
                  "Flexible & allergy aware party food",
                  "Personalised online invitations [NEW!]",
                  "You can bring your own birthday cake <strong>or order one through us!</strong>",
                  "Let us know the approx. number of children & which creations your child would like to make a week before the party",
                ]}
              />
            </div>
          </Step>
        </div>
      </section>
      <div class="my-24 text-center">
        <PrimaryButton
          text="Book a party"
          path="/birthday-parties/book-a-party/#book"
        />
      </div>
      <MixAndMatchParties />
      <Pricing />
      <PartyInformation partyPackage="Birthday" />
      <PartyPerks />
      <PartyFaq items={birthdayFaqItems} />
      <!-- <PartyPacks /> -->
    </div>
    <section class="relative mt-12 h-[450px]">
      <div
        class="relative z-10 flex h-full flex-col items-center justify-center gap-6"
      >
        <p
          class="mx-8 max-w-[800px] text-center font-lilita text-4xl uppercase text-white sm:text-6xl"
        >
          Cheltenham, Balwyn, Essendon, Kingsville & Malvern studios
        </p>
        <PrimaryButton
          text="Book a party"
          path="/birthday-parties/book-a-party/#book"
        />
      </div>
      <Image
        class="absolute top-0 z-0 h-full object-cover"
        src={essendonStudio}
        alt="background image of kids in a classroom"
      />
    </section>
    <div class="mx-auto block max-w-[1200px] px-5 py-8">
      <section class="my-12 flex flex-col gap-16 lg:flex-row lg:gap-8">
        <div class="flex w-full flex-col justify-center gap-4 lg:w-1/2">
          <p class="text-center font-lilita text-4xl lg:text-start">
            Fizz Kidz At Home Parties
          </p>
          <p
            class="text-center font-lilita text-2xl text-[#8DC54B] lg:text-start"
          >
            Sit back, relax and we will take care of everything!
          </p>
          <p class="text-center font-gotham font-medium lg:text-start">
            Our fabulous Fizz Kidz hosts will come to your home or a party venue
            near you, and run a fantastic stress-free party that we know your
            child, and their friends will love!
          </p>
          <div
            class="mt-8 flex flex-wrap justify-center gap-x-12 gap-y-6 lg:justify-start"
          >
            <PrimaryButton
              text="At Home Party Details"
              path="/birthday-parties/at-home-parties/"
            />
          </div>
        </div>
        <Image
          src={atHomeParties}
          alt="Fizz Kids running activities at someones home"
          class="object-fit w-full lg:w-[60%]"
        />
      </section>
      <Values />
    </div>
  </main>
</Layout>
