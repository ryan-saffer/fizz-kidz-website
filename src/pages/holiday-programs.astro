---
// import "@/styles/globals.css";
import { storyblokClient } from "@/utils/storyblok-api-client";
import HolidayProgramWeek from "@/components/holiday-program-week.astro";
import Layout from "@/layout/Layout.astro";
import { BreadcrumbWrapper } from "@/components/react/breadcrumb-wrapper";
import PageIntro from "@/components/page-intro.astro";
import holidayPrograms from "@/assets/images/pages/holiday-programs/holiday-programs.png";
import Step from "@/components/step.astro";
import forwardArrow from "@/assets/images/pages/parties/forward-arrow.png";
import StarBulletPoints from "@/components/star-bullet-points.astro";
import { Image } from "astro:assets";
import FaqAccordion from "@/components/react/faq-accordion";
import faq from "@/assets/images/pages/parties/packages/slime.png";
import why from "@/assets/images/pages/parties/packages/safari.png";
import {
  createBreadcrumbSchema,
  createFaqSchema,
  createServiceSchema,
} from "@/utils/seo";

const { default: greenDrop } = await import(
  `@/assets/images/pages/parties/drop-green.svg?raw`
);
const { default: blueDrop } = await import(
  `@/assets/images/pages/parties/drop-blue.svg?raw`
);
const { default: purpleDrop } = await import(
  `@/assets/images/pages/parties/drop-purple.svg?raw`
);

const programWeeks = await storyblokClient.getHolidayPrograms({
  status: import.meta.env.DEV ? "draft" : "published",
});

const holidayFaqItems = [
  {
    question: "Where do Fizz Kidz school holiday programs run?",
    answer:
      "Fizz Kidz school holiday programs run at our Balwyn, Cheltenham, Essendon, Kingsville and Malvern studios across Melbourne.",
  },
  {
    question: "What age group are Fizz Kidz holiday programs for?",
    answer:
      "Fizz Kidz holiday programs are best for children aged 4 to 12 years. Children must be completely toilet trained to attend.",
  },
  {
    question: "Can kids stay for the full day?",
    answer:
      "Yes. Families can book both a morning and afternoon program, and children are supervised during the break between sessions.",
  },
  {
    question: "What happens between morning and afternoon programs?",
    answer:
      "During the hour break between programs, children are fully supervised. They can eat their nut-free lunch from home and enjoy calm activities such as drawing, puzzles and crafts.",
  },
  {
    question: "What food is served?",
    answer:
      "Fizz Kidz provides a morning and afternoon snack for children attending the program. This usually includes rice crackers, fruit, corn chips and water. Children can bring their own nut-free snacks if needed.",
  },
  {
    question: "My child has allergies. What should I do?",
    answer:
      "Please list allergies when booking and tell the Fizz Kidz facilitators on the day. Children with an anaphylactic allergy must bring an epipen.",
  },
];
---

<Layout
  title="School Holiday Programs Melbourne | Fizz Kidz"
  description="Book creative school holiday programs for kids aged 4-12 at Fizz Kidz studios in Balwyn, Cheltenham, Essendon, Kingsville and Malvern."
  schema={[
    createServiceSchema({
      name: "School Holiday Programs Melbourne",
      description:
        "Creative school holiday programs for children aged 4 to 12 at Fizz Kidz studios across Melbourne.",
      url: "/holiday-programs/",
      serviceType: "School holiday program",
      areaServed: [
        "Melbourne",
        "Balwyn",
        "Cheltenham",
        "Essendon",
        "Kingsville",
        "Malvern",
      ],
    }),
    createFaqSchema("/holiday-programs/", holidayFaqItems),
    createBreadcrumbSchema([
      { name: "Home", url: "/" },
      { name: "Holiday Programs", url: "/holiday-programs/" },
    ]),
  ]}
>
  <main class="m-auto block max-w-[1380px] px-5 pt-4">
    <BreadcrumbWrapper
      client:idle
      items={[
        {
          type: "dropdown",
          title: "Holiday Programs",
          items: [
            {
              type: "link",
              title: "Birthday Parties",
              path: "/birthday-parties/",
              isNew: false,
            },
            {
              type: "link",
              title: "Holiday Programs",
              path: "/holiday-programs/",
              isNew: false,
            },
            {
              type: "link",
              title: "Preschool Program",
              path: "/preschool-program/",
              isNew: false,
            },
          ],
        },
      ]}
    />
    <PageIntro
      subtitle="Fizzing, Fantastic, Fabulous, Fun!"
      color="purple"
      actionButtonText="Book now"
      actionButtonPath="https://bookings.fizzkidz.com.au/programs?id=11036399"
      type="image"
      image={holidayPrograms}
      imageAlt="Holiday Programs"
    >
      <span slot="title">Fizz Kidz School Holiday Programs</span>
      <span slot="content"
        >Join us for creative, hands-on school holiday programs in Melbourne,
        where kids make awesome take-home Fizz Kidz creations at their closest
        studio.</span
      >
    </PageIntro>
    <section class="mt-12 rounded-3xl bg-[#F4EDFF] p-6 md:mt-40 md:p-10">
      <h2 class="font-lilita text-4xl text-[#9044E2] md:text-5xl">
        School holiday programs across Melbourne
      </h2>
      <p class="mt-4 max-w-5xl font-gotham text-lg font-medium leading-8">
        Fizz Kidz runs school holiday programs for kids aged 4 to 12 at our
        Balwyn, Cheltenham, Essendon, Kingsville and Malvern studios. Each
        session is designed for hands-on fun, with creative projects, science
        experiments, games, prizes and take-home creations.
      </p>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl bg-white p-5 shadow-around">
          <p class="font-lilita text-2xl text-[#9044E2]">Ages</p>
          <p class="mt-2 font-gotham font-medium">
            Best for children aged 4-12.
          </p>
        </div>
        <div class="rounded-2xl bg-white p-5 shadow-around">
          <p class="font-lilita text-2xl text-[#9044E2]">Sessions</p>
          <p class="mt-2 font-gotham font-medium">
            Morning and afternoon programs, with supervised full-day options.
          </p>
        </div>
        <div class="rounded-2xl bg-white p-5 shadow-around">
          <p class="font-lilita text-2xl text-[#9044E2]">Studios</p>
          <p class="mt-2 font-gotham font-medium">
            Balwyn, Cheltenham, Essendon, Kingsville and Malvern.
          </p>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap gap-3 font-gotham font-semibold">
        <a
          class="rounded-full bg-white px-4 py-2 text-[#9044E2]"
          href="/locations/balwyn/">Balwyn</a
        >
        <a
          class="rounded-full bg-white px-4 py-2 text-[#9044E2]"
          href="/locations/cheltenham/">Cheltenham</a
        >
        <a
          class="rounded-full bg-white px-4 py-2 text-[#9044E2]"
          href="/locations/essendon/">Essendon</a
        >
        <a
          class="rounded-full bg-white px-4 py-2 text-[#9044E2]"
          href="/locations/kingsville/">Kingsville</a
        >
        <a
          class="rounded-full bg-white px-4 py-2 text-[#9044E2]"
          href="/locations/malvern/">Malvern</a
        >
      </div>
    </section>
    <section class="mt-12 md:mt-20">
      <p class="text-center font-lilita text-5xl text-[#9044E2]">
        Upcoming School Holiday Programs
      </p>
      <p class="mt-6 text-center font-gotham text-xl font-semibold">
        Join us these school holidays for fizzing, fantastic fun!
      </p>
      <p class="mt-4 text-center font-gotham text-xl font-semibold">
        Balwyn, Cheltenham, Essendon, Kingsville and Malvern studios
      </p>
      <div
        class="mt-12 flex flex-col items-center justify-center gap-4 min-[1290px]:flex-row min-[1290px]:items-stretch"
      >
        <Step
          title="Choose your favourite program to attend"
          color="#4FE16D"
          number="1"
          background={greenDrop}
          backgroundPosition="-bottom-24 -left-12"
        >
          <div slot="content">
            <StarBulletPoints
              content={[
                "Make three fabulous Fizz Kidz creations",
                "Play games, win prizes and have fun!",
                "Morning and afternoon snack included",
              ]}
              className="pl-4"
            />
          </div>
        </Step>
        <Image
          src={forwardArrow}
          alt="forward arrow"
          class="h-16 w-fit self-center"
        />
        <Step
          title="Register your child"
          color="#42D4F3"
          number="2"
          background={blueDrop}
          backgroundPosition="-bottom-24 -left-8"
        >
          <div slot="content">
            <StarBulletPoints
              content={[
                "Each program is $54 per child.",
                "Fizz Kidz Holiday Programs are for children 4 - 12 years old, and all children must be completely toilet trained 😊.",
                "Stay for the day by booking the morning and afternoon program and we'll supervise the break.",
                "Max 25 children per program",
              ]}
              className="pl-4"
            />
          </div>
        </Step>
        <Image
          src={forwardArrow}
          alt="forward arrow"
          class="h-16 w-fit self-center"
        />
        <Step
          title="We will see you on the day!"
          color="#9044E2"
          number="3"
          background={purpleDrop}
          backgroundPosition="right-0 -bottom-24"
        >
          <div slot="content">
            <StarBulletPoints
              content={[
                "If your child is staying for the day, please pack lunch. Otherwise you don't need anything!",
                "If staying for the full day, children will be supervised inbetween sessions, with down time activities provided.",
                "We can't wait to have fun with you!",
              ]}
            />
          </div>
        </Step>
      </div>
    </section>
    {programWeeks.map((week) => <HolidayProgramWeek week={week} />)}
    <section class="my-12 md:my-24">
      <h6 class="mb-4 text-center font-lilita text-4xl md:text-5xl">
        Frequently Asked Questions
      </h6>
      <div class="flex w-full flex-col items-center gap-8 md:flex-row">
        <Image
          class="hidden w-2/5 md:block"
          src={faq}
          alt="Three girls smiling"
        />
        <div class="w-full md:w-3/5">
          <FaqAccordion client:visible items={holidayFaqItems} />
        </div>
      </div>
    </section>
    <section class="mb-24 flex flex-col-reverse items-center gap-8 md:flex-row">
      <div class="flex w-full flex-col gap-4 md:w-3/5">
        <p class="mb-4 font-lilita text-5xl text-[#9044E2]">
          Why choose a Fizz Kidz holiday program?
        </p>
        <p>
          Fizz Kidz holiday programs in Melbourne focus on hands on fun! Our
          holiday programs aim to be relevant, creative and provide an
          opportunity for all kids to explore and create fabulous creations and
          products.
        </p>
        <p>
          Fizz Kidz holiday programs include dancing games and competitions
          which get the children out of there seats and dancing around the room!
          Children are encouraged to also make new friends and get to know
          everyone in their group, often resulting in them not wanting to leave
          when getting picked up!
        </p>
      </div>
      <Image
        class="object-fit h-fit w-full md:w-2/5"
        src={why}
        alt="A frog in a bath bomb"
      />
    </section>
  </main>
</Layout>
