---
import PageIntro from "@/components/page-intro.astro";
import Layout from "@/layout/Layout.astro";
import PartyLayout from "@/layout/party-layout.astro";

import slime from "@/assets/images/pages/parties/slime-party.jpg";
import slimePackage from "@/assets/images/pages/parties/slime-creations-hero.png";
import Creations from "@/components/party-package-creations.astro";
import RainbowSlime from "@/components/creations/rainbow-slime.astro";
import FairySlime from "@/components/creations/fairy-slime.astro";
import BirthdayCakeSlime from "@/components/creations/birthday-cake-slime.astro";
import MonsterSlimeGreen from "@/components/creations/monster-slime-green.astro";
import CandySlime from "@/components/creations/candy-slime.astro";
import UnicornCloudSlime from "@/components/creations/unicorn-cloud-slime.astro";
import SpidermanSlime from "@/components/creations/spiderman-slime.astro";
import NutellaSlime from "@/components/creations/nutella-slime.astro";
import MarshmallowSlime from "@/components/creations/marshmallow-slime.astro";
import SwiftieSlime from "@/components/creations/swiftie-slime.astro";
import FluffySlimeBlue from "@/components/creations/fluffy-slime-blue.astro";
import FrozenSparkleSlimeGreen from "@/components/creations/frozen-sparkle-slime-green.astro";
import SlimeLab from "@/components/slime-lab.astro";
import FaqAccordion from "@/components/react/faq-accordion";
import {
  createBreadcrumbSchema,
  createFaqSchema,
  createServiceSchema,
} from "@/utils/seo";

const slimeFaqItems = [
  {
    question: "Where can I book a slime birthday party in Melbourne?",
    answer:
      "Fizz Kidz runs slime birthday parties at our Balwyn, Cheltenham, Essendon, Kingsville and Malvern studios across Melbourne.",
  },
  {
    question: "What age are slime parties best for?",
    answer:
      "Fizz Kidz slime parties are designed for children aged 4 to 12 years who love getting creative and hands-on.",
  },
  {
    question: "Do kids take their slime home?",
    answer:
      "Yes. Every child makes slime during the party and takes their creations home in their own Fizz Kidz party bag.",
  },
  {
    question: "Can children customise their slime?",
    answer:
      "Yes. Children can choose colours, glitters and add-ins, and Slime Lab lets slime-obsessed kids design their personalised slime from scratch.",
  },
];
---

<Layout
  title="Slime Birthday Parties Melbourne | Fizz Kidz"
  description="Book a kids slime birthday party in Melbourne at Fizz Kidz. Children make custom slime and take home their creations at our five studios."
  schema={[
    createServiceSchema({
      name: "Slime Birthday Parties Melbourne",
      description:
        "Hands-on slime birthday parties for children aged 4 to 12 at Fizz Kidz studios across Melbourne.",
      url: "/birthday-parties/slime-parties/",
      serviceType: "Slime birthday party",
      areaServed: [
        "Melbourne",
        "Balwyn",
        "Cheltenham",
        "Essendon",
        "Kingsville",
        "Malvern",
      ],
    }),
    createFaqSchema("/birthday-parties/slime-parties/", slimeFaqItems),
    createBreadcrumbSchema([
      { name: "Home", url: "/" },
      { name: "Birthday Parties", url: "/birthday-parties/" },
      { name: "Slime Parties", url: "/birthday-parties/slime-parties/" },
    ]),
  ]}
>
  <PartyLayout partyPackage="Slime">
    <PageIntro
      slot="intro"
      subtitle="Slime, slime and more slime!"
      type="image"
      image={slime}
      imageAlt="a kid holding a long stretch of slime and smiling"
      actionButtonText="Book a party"
      actionButtonPath="/birthday-parties/book-a-party/#book"
      color="purple"
    >
      <span slot="title">Kids Slime Birthday Parties</span>
      <span slot="content">
        For slime lovers, Fizz Kidz slime birthday parties in Melbourne are all
        about colour, glitter, add-ins and hands-on messy fun.
      </span>
    </PageIntro>
    <section class="m-auto mb-0 mt-20 block max-w-[1380px] px-5 md:mt-36">
      <div class="rounded-3xl bg-[#F4EDFF] p-6 md:p-10">
        <h2 class="font-lilita text-4xl text-[#9044E2] md:text-5xl">
          A hands-on slime party kids can customise
        </h2>
        <p class="mt-4 max-w-5xl font-gotham text-lg font-medium leading-8">
          Our slime party package is one of our most popular kids birthday party
          options. Children make slime, choose colours and glitter, play dancing
          games, and take their creations home. Slime parties are available at
          our Balwyn, Cheltenham, Essendon, Kingsville and Malvern studios.
        </p>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          <div class="rounded-2xl bg-white p-5 shadow-around">
            <p class="font-lilita text-2xl text-[#9044E2]">Best for</p>
            <p class="mt-2 font-gotham font-medium">
              Children aged 4 to 12 who love sensory, creative and messy play.
            </p>
          </div>
          <div class="rounded-2xl bg-white p-5 shadow-around">
            <p class="font-lilita text-2xl text-[#9044E2]">Take-home fun</p>
            <p class="mt-2 font-gotham font-medium">
              Every child leaves with their own slime creations.
            </p>
          </div>
          <div class="rounded-2xl bg-white p-5 shadow-around">
            <p class="font-lilita text-2xl text-[#9044E2]">Studios</p>
            <p class="mt-2 font-gotham font-medium">
              Book a slime party in Balwyn, Cheltenham, Essendon, Kingsville or
              Malvern.
            </p>
          </div>
        </div>
        <div class="mt-10">
          <h3 class="mb-4 font-lilita text-3xl text-[#9044E2]">
            Slime party FAQs
          </h3>
          <FaqAccordion client:visible items={slimeFaqItems} />
        </div>
      </div>
    </section>
    <Creations
      image={slimePackage}
      imageAlt="Slime Party Pacakge"
      partyPackage="Slime"
      hideLeftImage
      topSpacing="compact"
    >
      <FairySlime slot="1" flippable={false} />
      <BirthdayCakeSlime slot="2" flippable={false} />
      <MonsterSlimeGreen slot="3" flippable={false} />
      <CandySlime slot="4" flippable={false} />
      <UnicornCloudSlime slot="5" flippable={false} />
      <FluffySlimeBlue slot="6" flippable={false} />
      <SpidermanSlime slot="7" flippable={false} />
      <NutellaSlime slot="8" flippable={false} />
      <MarshmallowSlime slot="9" flippable={false} />
      <SwiftieSlime slot="10" flippable={false} />
      <RainbowSlime slot="11" flippable={false} />
      <FrozenSparkleSlimeGreen slot="12" flippable={false} />
    </Creations>
    <SlimeLab />
  </PartyLayout>
</Layout>
